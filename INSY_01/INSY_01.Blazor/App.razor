<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <title>INSY_01 · [ConcurrencyCheck]</title>
    <HeadOutlet />
    <style>
        /* all styles live here on purpose — fewer files */
        :root {
            font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
            color: #1e293b;
            background: #f1f5f9;
        }

        * { box-sizing: border-box; }
        body { margin: 0; }
        .container { max-width: 1280px; margin: 0 auto; padding: 24px 20px 48px; }
        h1 { font-size: 1.5rem; margin: 0 0 6px; }
        h2 { font-size: 1.02rem; margin: 0 0 10px; }
        .sub { margin: 0 0 16px; color: #475569; font-size: 0.92rem; max-width: 76ch; line-height: 1.5; }
        code { background: #e2e8f0; padding: 1px 5px; border-radius: 4px; font-size: 0.85em; }

        .banner {
            background: #fee2e2; color: #991b1b; border: 1px solid #fca5a5;
            padding: 10px 14px; border-radius: 8px; margin-bottom: 14px; font-size: 0.9rem;
        }
        .banner pre { margin: 6px 0 0; font-size: 0.78rem; white-space: pre-wrap; word-break: break-word; }
        .banner .hint { display: block; margin-top: 6px; }

        .grid { display: grid; grid-template-columns: 1.1fr 1.2fr; gap: 16px; align-items: start; }
        @@media (max-width: 980px) { .grid { grid-template-columns: 1fr; } }

        .card {
            background: #fff; border: 1px solid #e2e8f0; border-radius: 10px;
            padding: 14px 16px; margin-bottom: 16px;
        }

        .row { display: flex; align-items: center; gap: 8px; margin-top: 10px; flex-wrap: wrap; }
        .hint { color: #64748b; font-size: 0.82rem; margin: 10px 0 0; line-height: 1.5; }
        .muted { color: #94a3b8; font-style: italic; }

        .btn {
            padding: 6px 12px; border: 1px solid #cbd5e1; border-radius: 6px;
            background: #fff; color: #1e293b; font-size: 0.85rem; font-weight: 600; cursor: pointer;
        }
        .btn:hover:not(:disabled) { background: #f8fafc; border-color: #94a3b8; }
        .btn:disabled { opacity: 0.4; cursor: default; }
        .btn-err { background: #fef2f2; border-color: #fca5a5; color: #b91c1c; }
        .btn-ok { background: #f0fdf4; border-color: #86efac; color: #15803d; }
        .btn-reset { margin-left: auto; }

        .tbl { width: 100%; border-collapse: collapse; }
        .tbl th, .tbl td { text-align: left; padding: 7px 10px; border-bottom: 1px solid #e2e8f0; font-size: 0.92rem; }
        .tbl th { color: #64748b; font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.04em; }

        pre.code {
            background: #0f172a; color: #e2e8f0; border-radius: 8px;
            padding: 10px 12px; font-size: 0.8rem; line-height: 1.5;
            overflow-x: auto; margin: 0;
        }

        .logcard { position: sticky; top: 16px; }
        .log {
            background: #0f172a; border-radius: 8px; padding: 10px 12px;
            height: 620px; overflow-y: auto;
            font-family: ui-monospace, "Cascadia Code", Consolas, monospace;
        }
        .logline { display: grid; grid-template-columns: 88px 52px 1fr; gap: 10px; padding: 3px 0; align-items: start; }
        .ts { color: #64748b; font-size: 0.72rem; white-space: nowrap; }
        .tag { font-size: 0.72rem; font-weight: 700; }
        .msg { margin: 0; white-space: pre-wrap; word-break: break-word; font-size: 0.78rem; line-height: 1.45; }
        .k-info .tag { color: #94a3b8; } .k-info .msg { color: #94a3b8; }
        .k-sql .tag { color: #38bdf8; } .k-sql .msg { color: #7dd3fc; }
        .k-tx .tag { color: #4ade80; } .k-tx .msg { color: #86efac; font-weight: 600; }
        .k-ok .tag { color: #a3e635; } .k-ok .msg { color: #d9f99d; }
        .k-warn .tag { color: #fbbf24; } .k-warn .msg { color: #fde68a; }
        .k-err .tag { color: #f87171; } .k-err .msg { color: #fca5a5; }
    </style>
</head>

<body>
    <Router AppAssembly="typeof(App).Assembly">
        <Found Context="routeData">
            <RouteView RouteData="routeData" />
        </Found>
        <NotFound>
            <p>404 — nothing at this address.</p>
        </NotFound>
    </Router>
    <script src="_framework/blazor.web.js"></script>
</body>

</html>
